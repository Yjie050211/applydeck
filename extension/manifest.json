{
  "manifest_version": 3,
  "name": "投递舱采集器 ApplyDeck Capture",
  "version": "0.1.0",
  "description": "在 BOSS直聘 / 实习僧 / 牛客 职位详情页一键采集 JD，写入本机投递舱（127.0.0.1:8788）。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*"
  ],
  "action": {
    "default_title": "加入投递舱",
    "default_popup": "popup.html"
  }
}
